PATH_add bin
PATH_add exe

export RUBYOPT="-W0" # silence deprecation warnings
export LOG_LEVEL=info

declare -a encryption_candidates
encryption_candidates=(.env .env.development .env.staging .env.production)

function dev-secrets-manage() {
  local action=$1
  local original=$2
  local encrypted="${original}.encrypted"

  if [[ ${action} == "encrypt" ]]; then
    sopsy encrypt "${original}" -o "${encrypted}"
  elif [[ ${action} == "decrypt" ]]; then
    sopsy decrypt "${encrypted}" -o "${original}"
  else
    echo "Usage: dev-secrets-manage <encrypt|decrypt> <file>"
    return 1
  fi
}

function refresh() {
  local -a decrypted_candidates=( $@ )
  local encrypted original

  for original in "${decrypted_candidates[@]}"; do
      encrypted="${original}.encrypted"

     if [[ -s ${original} && ! -s ${encrypted} || ${original} -nt ${encrypted} ]]; then

       # original file exists and is newer than the encrypted file.
       eval "$(cat ${original} | sed -E '/^#/d; /^$/d; s/^([A-Z])/export \1/g')"

     elif [[ -s ${encrypted} && ! -s ${original} ||
             -s ${encrypted} &&   -s ${original} && ${encrypted} -nt ${original} ]]; then

       dev-secrets-manage decrypt "${encrypted}"

       # Load the original encrypted into the environment, ignoring comments and blank lines, and prefixing each variable with "export ".
       eval "$(cat ${original} | sed -E '/^#/d; /^$/d; s/^([A-Z])/export \1/g')"
     fi
  done
}

command -v sopsy >/dev/null 2>&1 && {
  refresh "${encryption_candidates[@]}"
 } || {
  echo "sopsy is not installed. Please install it to manage secrets."
}





